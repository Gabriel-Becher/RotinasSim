<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_tarefa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="10dp"
        >

        <ImageView
            android:id="@+id/imagemTarefa"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_launcher_background"
            android:layout_marginEnd="12dp"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tituloTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:id="@+id/descricaoTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/colorOnSurface"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/dataTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/colorPrimary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/recorrenciaTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorSecondary"
                android:layout_marginTop="2dp"
                android:text="@string/label_recorrente"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginRight="10dp"
            >

            <Button
                android:id="@+id/botaoConcluir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/acao_concluir"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorSuccess"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/botaoExcluir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/acao_excluir"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorError"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
